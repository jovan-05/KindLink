# Copy to .env (repo root). Never commit real values.
# --- backend (FastAPI) ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
OPENROUTER_API_KEY=
# Optional: comma-separated OpenRouter model ids, tried in order. Only ":free" models are accepted.
LLM_MODEL=
# Optional: Postgres for Qloo cache + plan storage (in-memory if unset)
DATABASE_URL=
# Origins allowed to call the API directly (only needed if the browser talks to the backend directly)
CORS_ORIGINS=http://localhost:3000
# --- frontend (Next.js) ---
# Server-side only: where Next.js proxies /api/* to
BACKEND_URL=http://127.0.0.1:8000
